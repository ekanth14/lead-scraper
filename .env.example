# ═══════════════════════════════════════════════════════════════════
# Lead Scraper — Environment Variables
# Copy this file to .env and fill in your keys.
# ═══════════════════════════════════════════════════════════════════

# ── Google Maps Places API ────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a project (or select existing)
# 3. Enable "Places API" and "Maps JavaScript API"
# 4. Create an API key → restrict to Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Apify (Instagram & LinkedIn scraping) ─────────────────────────
# 1. Sign up at https://apify.com
# 2. Go to https://console.apify.com/account/integrations
# 3. Copy your API token
# Free tier: 10K results/month
APIFY_TOKEN=your_apify_token_here

# ── Anthropic (Claude AI for outreach DMs) ────────────────────────
# 1. Sign up at https://console.anthropic.com
# 2. Go to Settings → API Keys
# 3. Create a new key
# Uses claude-sonnet-4-6 model
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Supabase ──────────────────────────────────────────────────────
# 1. Create a project at https://supabase.com/dashboard
# 2. Go to Project Settings → API
# 3. Copy the URL and anon/public key
# 4. Run supabase_setup.sql in the SQL Editor first!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Frontend URL (CORS) ──────────────────────────────────────────
# The URL where your frontend is hosted.
# http://localhost:5173 is always allowed by default.
FRONTEND_URL=http://localhost:5173
